# DeepResearch AI - Environment Configuration Example
# Copy this file to .env and insert your real Gemini API key.

# Google Gemini API Key (Required)
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# SQLite Database Path (Optional, defaults to research_agent.db)
DATABASE_PATH=research_agent.db
